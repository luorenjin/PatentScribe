# Qwen (Alibaba) API Key (required for default provider)
VITE_QWEN_API_KEY=

# Gemini API Key (optional)
GEMINI_API_KEY=

# OpenAI API Key (optional)
VITE_OPENAI_API_KEY=

# Testing Flags
# Set to 'true' to force show the onboarding modal on every launch
VITE_DEBUG_SHOW_ONBOARDING=false

# Software Activation Public Key (RSA PEM format, use \n for newlines)
LICENSE_PUBLIC_KEY=

# Activation Settings
# Whether to require activation for file upload/analysis
VITE_REQUIRE_ACTIVATION=true
# Enable email verification method
VITE_ENABLE_EMAIL_VERIFICATION=true
# Enable license file verification method
VITE_ENABLE_LICENSE_FILE=true
# Allowed email domains (comma separated)
VITE_ALLOWED_EMAIL_DOMAINS=company.com,patent.org
# API Base URL for activation
VITE_ACTIVATION_API_BASE_URL=https://api.patentmate.ai/v1/activation
# Activation Support Email
VITE_ACTIVATION_SUPPORT_EMAIL=support@patentmate.ai


