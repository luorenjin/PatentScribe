{
  "productName": "PatentScribe",
  "version": "../package.json",
  "identifier": "com.patentscribe.app",
  "build": {
    "beforeDevCommand": "yarn dev",
    "beforeBuildCommand": "yarn build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "fullscreen": false,
        "height": 800,
        "resizable": true,
        "title": "PatentScribe - AI 专利协作专家",
        "width": 1200
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "copyright": "Copyright © 2026 PatentScribe",
    "externalBin": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "longDescription": "An AI-powered patent disclosure tool.",
    "shortDescription": "PatentScribe Desktop",
    "targets": "all"
  },
  "plugins": {
    "sql": null,
    "store": null,
    "shell": {
      "open": true
    },
    "dialog": null,
    "notification": null,
    "fs": {
      "requireLiteralLeadingDot": false
    }
  }
}
